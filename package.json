{
  "name": "hussein-browser",
  "productName": "H Browser",
  "version": "1.2.0",
  "description": "H Browser: a fast, simple web browser with built-in ad, tracker and popup blocking.",
  "main": "main.js",
  "author": "Alawieh",
  "license": "MIT",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/Alawieh/h-browser.git"
  },
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --publish never"
  },
  "dependencies": {
    "@ghostery/adblocker-electron": "2.20.3",
    "cross-fetch": "4.1.0",
    "electron-updater": "6.8.11"
  },
  "devDependencies": {
    "electron": "45.4.1",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "com.alawieh.husseinbrowser",
    "productName": "H Browser",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "hider.js",
      "lib/**/*",
      "ui/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "H Browser",
      "runAfterFinish": true,
      "artifactName": "H-Browser-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "H-Browser-Portable-${version}.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Alawieh",
        "repo": "h-browser"
      }
    ]
  }
}
